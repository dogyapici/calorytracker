# Postgres connection string (e.g. Supabase or Neon). Use the pooled connection on Vercel.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Code people must enter to create an account. Share it only with the people who should use the app.
INVITE_CODE=choose-something-long

# Optional: contact e-mail sent in the User-Agent to Open Food Facts, as they request.
OFF_CONTACT=you@example.com

# Optional: time zone that decides what "today" is. Defaults to Europe/Berlin.
# APP_TIME_ZONE=Europe/Berlin
