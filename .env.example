# Postgres connection string (e.g. Supabase or Neon). Use the pooled connection on Vercel.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Code people must enter to create an account. Share it only with the people who should use the app.
INVITE_CODE=choose-something-long

# Optional: contact e-mail sent in the User-Agent to Open Food Facts, as they request.
OFF_CONTACT=you@example.com

# Optional: time zone that decides what "today" is. Defaults to Europe/Berlin.
# APP_TIME_ZONE=Europe/Berlin

# Optional: enables "Mahlzeit per Foto schätzen" with Google Gemini (free tier).
# Create a key at https://aistudio.google.com/apikey. Without a key the feature shows a hint instead.
# GEMINI_API_KEY=...
# Optional: Gemini model. Defaults to gemini-flash-latest.
# GEMINI_MODEL=gemini-flash-latest

# Optional alternative: Claude by Anthropic (paid). Used only when GEMINI_API_KEY is not set.
# Create a key at https://console.anthropic.com (Settings → API Keys).
# ANTHROPIC_API_KEY=sk-ant-...
# Optional: Claude model. Defaults to claude-sonnet-5.
# AI_MODEL=claude-sonnet-5
